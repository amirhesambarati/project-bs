--cpu Cortex-M3
"1-uart-tx\startup_stm32f103xb.o"
"1-uart-tx\main.o"
"1-uart-tx\stm32f1xx_it.o"
"1-uart-tx\stm32f1xx_hal_msp.o"
"1-uart-tx\stm32f1xx_hal_gpio_ex.o"
"1-uart-tx\stm32f1xx_hal_uart.o"
"1-uart-tx\stm32f1xx_hal.o"
"1-uart-tx\stm32f1xx_hal_rcc.o"
"1-uart-tx\stm32f1xx_hal_rcc_ex.o"
"1-uart-tx\stm32f1xx_hal_gpio.o"
"1-uart-tx\stm32f1xx_hal_dma.o"
"1-uart-tx\stm32f1xx_hal_cortex.o"
"1-uart-tx\stm32f1xx_hal_pwr.o"
"1-uart-tx\stm32f1xx_hal_flash.o"
"1-uart-tx\stm32f1xx_hal_flash_ex.o"
